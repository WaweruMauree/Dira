PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for POST /api/v1/onboarding (persists course, profile, skills, interests)
SUPABASE_SERVICE_ROLE_KEY=
# Optional job listings (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
# Required for agent chat and custom-role Skills Analysis (https://openrouter.ai/) — backend only, not VITE_*
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Used when chat messages include images (defaults to OPENROUTER_MODEL)
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Cap completion tokens (avoids OpenRouter 402 when balance is low)
OPENROUTER_MAX_TOKENS=2048
# Optional faster model for skill rubric hovers only (defaults to OPENROUTER_MODEL)
# OPENROUTER_RUBRIC_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
# Required for chat web research (general mode webSearch tool) and CV builder research (https://exa.ai/)
EXA_API_KEY=
# Optional: skip OpenRouter on career pathway generate (faster demos; uses fallback copy)
# PATHWAY_SKIP_LLM=true
# One-time admin bootstrap (npm run create-admin) — only runs if no row in admins table
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Dira Admin
ADMIN_PHONE=
